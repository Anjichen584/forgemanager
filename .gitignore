# ---- 构建产物 ----
target/
build/
out/
*.jar
!.mvn/wrapper/maven-wrapper.jar

# ---- 本地测试服（部署验证用，不该进版本库）----
testserver/
logs/
*.log
crash-reports/

# ---- 运行时数据（插件在服务端写出来的，不是源码）----
plugins/
world/
world_nether/
world_the_end/

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
*.code-workspace

# ---- 系统 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- 临时 / 缓存 ----
*.tmp
*.bak
*.swp
*~
.tmp/
.cache/
*.zcode-session

# ---- AI / 工具生成的会话记录（不是源码，别进公开仓库）----
# 注意：.agents/ 是例外 —— 身份卡、索引、交接约定必须入库，
# 否则换机器/新会话/别人接手时等于不存在（这正是以前「漏读」的根因）。
.workbuddy/*
.zcode/*
.serena/
*.zcode
*.zcode-session

# .agents：身份卡与索引入库，串行锁和一次性草稿不入库
.agents/_lock.json
.agents/*/scratch/

# 例外必须放在最后。两个坑都踩过：
# 1) `*.zcode` 会连 `.zcode` 这个**目录名**一起匹配掉；
# 2) git 的规则是「父目录被排除时，里面的文件无法再被重新包含」，
#    所以要先把目录本身 `!.zcode/` 救回来，再排内容，再救单个文件。
!.zcode/
.zcode/*
!.zcode/README.md
!.workbuddy/README.md

# ---- 一次性测试输出 ----
selftest-stage2.txt
selftest-stage*.txt
RESULT-selftest-*.txt
.agents/_current
